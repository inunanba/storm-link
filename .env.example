# All values are optional; defaults shown.
# IRIS 2026.3 AI Hub Community image (build 154), loaded and tagged locally.
EAP_IMAGE_REF=iris-ai-hub:local154
# Host address for the Management Portal (keep on 127.0.0.1).
STORM_PORTAL_BIND=127.0.0.1:52774
# Compose project name (isolates containers/networks from other projects).
STORM_PROJECT=stormlink
STORM_MODE=replay
STORM_MODEL=llama3.2-3b-ctx16k:latest
STORM_OLLAMA_URL=http://host.docker.internal:11434
